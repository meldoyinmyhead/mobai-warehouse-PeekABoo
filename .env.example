# AI Warehouse Service - Environment Configuration
# Copy this file to .env and customize the values

# Application Settings
APP_NAME=AI Warehouse Service
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Data Paths (relative to project root)
RAW_DATA_DIR=ai/data/raw
PROCESSED_DATA_DIR=ai/data/processed
MODELS_DIR=ai/data/models
CACHE_DIR=ai/data/cache

# Raw Data Files
RAW_DATA_FILE=WMS_Hackathon_DataPack_Templates_FR_FV_B7_ONLY.xlsx

# Model Training Settings
TRAINING_TEST_SPLIT=0.2
RANDOM_STATE=42
N_JOBS=-1

# Forecasting Settings
DEFAULT_FORECAST_PERIODS=7
DEFAULT_FORECAST_MODEL=xgboost
MAX_LAG_FEATURES=14
ROLLING_WINDOWS=7,14,30

# ABC-XYZ Segmentation Thresholds
ABC_THRESHOLD_A=0.70
ABC_THRESHOLD_B=0.90
XYZ_THRESHOLD_X=0.15
XYZ_THRESHOLD_Y=0.35

# Storage Optimization Weights
WEIGHT_VOLUME=0.3
WEIGHT_TURNOVER=0.4
WEIGHT_DISTANCE=0.3

# Picking Optimization Settings
WAVE_SIZE_MIN=20
WAVE_SIZE_MAX=100
BATCH_SIZE_MAX=50
MAX_ZONES_PER_WAVE=3

# Database Settings (if using database instead of files)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=warehouse_ai
# DB_USER=postgres
# DB_PASSWORD=password

# Cache Settings
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Monitoring and Logging
LOG_FILE=ai/logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# CORS Settings (for web frontend)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
